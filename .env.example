# Environment file selection (src/config/env.js):
#   NODE_ENV=production  -> loads .env.prod
#   NODE_ENV=development -> loads .env.dev
#   otherwise            -> loads .env
# Required variables (startup fails if missing): PORT, DB_HOST, DB_USER, DB_PASSWORD, DB_NAME, JWT_SECRET

# Server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=link_status
DB_USER=root
DB_PASSWORD=secret

# Default admin account (created on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# SMTP (mail alerts). Leave SMTP_HOST empty to disable mail sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Link Status Monitor <no-reply@example.com>"
